{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charonyuu/jobpocket-card/schema/card.v1.json",
  "title": "Job Pocket résumé card, version 1",
  "description": "What jobpocket-card sends to yourjobpocket.com. Text only; the website re-checks every field, drops unknown ones and removes phone numbers and emails from text.",
  "type": "object",
  "required": [
    "v",
    "card"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "card": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "maxLength": 160
        },
        "location": {
          "type": "string",
          "maxLength": 40
        },
        "experiences": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "role",
              "org"
            ],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "maxLength": 80
              },
              "org": {
                "type": "string",
                "maxLength": 80
              },
              "start": {
                "type": "string",
                "description": "YYYY-MM or YYYY"
              },
              "end": {
                "type": "string",
                "description": "YYYY-MM or YYYY; empty when current"
              },
              "current": {
                "type": "boolean"
              },
              "what": {
                "type": "string",
                "maxLength": 140
              },
              "highlights": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "maxLength": 220
                }
              }
            }
          }
        },
        "education": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "school"
            ],
            "additionalProperties": false,
            "properties": {
              "school": {
                "type": "string",
                "maxLength": 80
              },
              "major": {
                "type": "string",
                "maxLength": 80
              },
              "degree": {
                "type": "string",
                "maxLength": 40
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "links": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 30
              },
              "url": {
                "type": "string",
                "pattern": "^https://",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "fromChat": {
      "type": "array",
      "description": "Fields containing anything the user only said in the chat, not on the résumé. The website asks them to confirm these.",
      "items": {
        "enum": [
          "title",
          "summary",
          "location",
          "experiences",
          "education",
          "skills",
          "links"
        ]
      }
    },
    "resumeEmail": {
      "type": "string",
      "maxLength": 254,
      "description": "The email printed on the résumé. Never shown; only a hash is kept to give the 本人認證 badge when the person saves with the same email."
    },
    "theme": {
      "enum": [
        "clean",
        "term",
        "neo",
        "magazine",
        "research",
        "creative",
        "dev",
        "photo-blue",
        "photo-term",
        "photo-neo"
      ],
      "description": "Optional card style, picked from the person's role (see SKILL.md › Pick a card style). Anything else is ignored and the website uses clean (極簡白). The person can switch styles on the preview page."
    }
  }
}
